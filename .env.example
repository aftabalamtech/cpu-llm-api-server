# Server
PORT=8080
HOST=0.0.0.0
API_KEY=change-me
MODEL_ALIAS=local-model

# Model selection. MODEL_PATH wins when it points to an existing file.
MODEL_PATH=/models/model.gguf
MODEL_REPO=ggml-org/gemma-3-1b-it-GGUF
MODEL_FILE=gemma-3-1b-it-Q4_K_M.gguf
MODEL_REVISION=main
HF_TOKEN=

# Low-resource CPU defaults
CPU_THREADS=2
CPU_THREADS_BATCH=2
CONTEXT_SIZE=2048
BATCH_SIZE=256
UBATCH_SIZE=128
PARALLEL=1

# Optional behavior
DOWNLOAD_MODEL=true
MODEL_DIR=/models
LLAMA_SERVER_BIN=llama-server
LOG_VERBOSITY=3
CORS_ORIGINS=*

# Optional override for the container image or local installation.
# LLAMA_SERVER_ARGS=
